# ============================================================
# TerasOps — environment template (NO real secrets here)
# Copy to .env.local and fill in real values.
# ============================================================

# ---- Supabase -------------------------------------------------
# Public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only admin key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI Providers (server-only, fallback chain in order) ------
# Provider 1 — primary: OpenRouter (OpenAI-compatible gateway)
# BASE_URL: selalu https://openrouter.ai/api/v1
AI_PROVIDER_1_NAME=openrouter
AI_PROVIDER_1_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_1_API_KEY=sk-or-v1-xxxx   # dari https://openrouter.ai/keys
AI_PROVIDER_1_MODEL=stealth/ox-alpha  # model gratis (cek https://openrouter.ai/models)

# Provider 2 — fallback: Google Gemini (Google AI Studio)
# BASE_URL tidak dipakai adapter Gemini, tapi tetap diisi sebagai referensi.
AI_PROVIDER_2_NAME=gemini
AI_PROVIDER_2_BASE_URL=https://generativelanguage.googleapis.com
AI_PROVIDER_2_API_KEY=AIza...   # dari https://aistudio.google.com/apikey (harus diawali "AIza")
AI_PROVIDER_2_MODEL=gemini-3.6-flash

# Maximum rows extracted from an Excel sheet (token control)
EXTRACTION_MAX_ROWS=200
